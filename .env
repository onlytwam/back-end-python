
# TWAM Backend — Environment Variables
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:Vishnu@localhost:5432/twam_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=1a8d735146cd243d4f3397396f3ebfc58cc550442663b3deb7e37f5cdd9b9b06

JWT_ALGORITHM=HS512
JWT_ISSUER=http://127.0.0.1:8000
JWT_AUDIENCE=twam-web-portal
JWT_EXPIRES_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces after commas)
# Add capacitor://localhost for iOS/Android Capacitor builds
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost

# ── File Storage ─────────────────────────────────────────────────────────────
# Base URL prepended to image paths stored in the database
# Dev: leave empty or use http://localhost:8000
# Prod: use your CDN or S3 public URL
BASE_URL=http://127.0.0.1:8000

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# .\venv1\Scripts\Activate.ps1
# main:app --host 127.0.0.1 --port 8000 --reload


# ── Company Info (used in notifications) ───────────────────────────────────────
COMPANY_NAME=TWAM
SUPPORT_EMAIL=customersupport@onlytwam.com
SUPPORT_PHONE=+91-7036534449

# ═══════════════════════════════════════════════════════════════════════════════
# EKART LOGISTICS INTEGRATION
# ═══════════════════════════════════════════════════════════════════════════════

# ── Ekart API Credentials ──────────────────────────────────────────────────────
# Get these from your Ekart Logistics dashboard
EKART_API_URL=
EKART_API_KEY=
EKART_API_SECRET=
EKART_SELLER_ID=

# ── Pickup & Return Locations ──────────────────────────────────────────────────
# These are location IDs registered with Ekart
EKART_PICKUP_ID=
EKART_RETURN_ID=

# Return warehouse address used for reverse pickups
EKART_RETURN_NAME=
EKART_RETURN_PHONE=
EKART_RETURN_ADDRESS_LINE1=
EKART_RETURN_ADDRESS_LINE2=
EKART_RETURN_CITY=
EKART_RETURN_STATE=
EKART_RETURN_PINCODE=
EKART_RETURN_COUNTRY=India

# ── Webhook Security ───────────────────────────────────────────────────────────
# Secret for verifying Ekart webhook callbacks
EKART_WEBHOOK_SECRET=

# ── Mock Mode (for testing without Ekart API) ──────────────────────────────────
# Set to "true" to use mock responses instead of real API calls
EKART_MOCK_MODE=true

# ── Tracking URL ───────────────────────────────────────────────────────────────
TRACKING_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════════════

# ── SMS Integration (placeholder - add your provider) ──────────────────────────
# Example for MSG91:
# SMS_API_URL=https://api.msg91.com/api/v5/flow/
# SMS_API_KEY=your_msg91_auth_key
# SMS_TEMPLATE_ID=your_template_id

# Example for Twilio:
# SMS_API_URL=https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json
# SMS_API_KEY=your_twilio_auth_token
# SMS_ACCOUNT_SID=your_twilio_account_sid
# SMS_FROM_NUMBER=+1234567890

SMS_API_URL=
SMS_API_KEY=

# ── WhatsApp Integration (optional) ────────────────────────────────────────────
# Example for Gupshup:
# WHATSAPP_API_URL=https://api.gupshup.io/sm/api/v1/msg
# WHATSAPP_API_KEY=your_gupshup_api_key

# Example for Twilio:
# WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/{AccountSid}/Messages.json
# WHATSAPP_API_KEY=your_twilio_auth_token

WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# PAYMENT GATEWAY (if applicable)
# ═══════════════════════════════════════════════════════════════════════════════
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
