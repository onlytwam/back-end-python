# ────────────────────────────────────────────────────────────────────────────
# TWAM Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:Vishnu@localhost:5432/twam_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_secret_key_here

JWT_ALGORITHM=HS512
JWT_ISSUER=http://127.0.0.1:8000
JWT_AUDIENCE=twam-web-portal
JWT_EXPIRES_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces after commas)
# Add capacitor://localhost for iOS/Android Capacitor builds
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost

# ── File Storage ─────────────────────────────────────────────────────────────
# Base URL prepended to image paths stored in the database
# Dev: leave empty or use http://localhost:8000
# Prod: use your CDN or S3 public URL
BASE_URL=http://127.0.0.1:8000

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
# .\venv1\Scripts\Activate.ps1
# main:app --host 127.0.0.1 --port 8000 --reload